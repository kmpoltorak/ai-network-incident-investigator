# Copy to .env and adjust. Never commit .env.

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# Used by the app when running outside Docker Compose (make run).
# Docker Compose overrides this to point at the postgres service.
DATABASE_URL=postgres://investigator:investigator@localhost:5432/investigator?sslmode=disable

# rules (offline, deterministic) | openai | ollama
LLM_PROVIDER=rules
# Defaults: gpt-4o-mini (openai), llama3.2 (ollama)
LLM_MODEL=
LLM_TIMEOUT=60s
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# healthy | packet_loss | dns_failure | tcp_failure | high_latency
SIMULATION_ENABLED=true
SIMULATION_SCENARIO=healthy

INVESTIGATION_TIMEOUT=90s
MAX_CONCURRENT_INVESTIGATIONS=4
